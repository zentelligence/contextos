filters: 'status != "archived"'
formulas:
  display_status: 'if(status == "done", "done", "open: " + status)'
  days_open: '(now() - created).days'
properties:
  status:
    displayName: Status
  formula.display_status:
    displayName: Display status
summaries:
  total_days: 'values.sum()'
views:
  - type: table
    name: All
    order:
      - file.name
      - status
      - formula.display_status
    groupBy:
      property: status
      direction: ASC
    sort:
      - property: file.name
        direction: ASC
    summaries:
      days_open: Sum
  - type: cards
    name: By status
    filters: 'formula.days_open > 0'
    limit: 20
